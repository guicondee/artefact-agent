# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.

# --- LLM (DeepSeek) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# enabled | disabled  (decidido no ADR-001 após o teste da Etapa 0)
DEEPSEEK_THINKING=disabled

# --- Embeddings (Google Gemini) ---
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Banco (Postgres + pgvector via docker compose) ---
POSTGRES_USER=emporio
POSTGRES_PASSWORD=emporio_dev
POSTGRES_DB=emporio
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- LangSmith (tracing, avaliação e Studio) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=emporio-agent
