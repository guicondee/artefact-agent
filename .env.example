# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.

# --- LLM (DeepSeek) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# enabled | disabled  (ver ADR-001)
DEEPSEEK_THINKING=disabled

# --- Embeddings (Google Gemini) ---
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Banco (Postgres + pgvector via docker compose) ---
POSTGRES_USER=emporio
POSTGRES_PASSWORD=emporio_dev
POSTGRES_DB=emporio
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Senha do role somente leitura usado pelo agente (criado por emporio_agent.load_data)
AGENT_RO_PASSWORD=agent_ro_dev

# --- LangSmith (tracing, avaliação e Studio) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=emporio-agent
